# MagicalBall VPS — copy to repo root:  cp deploy/env.example .env
# Or run on VPS:  bash deploy/setup-vps.sh  (auto-fills from /opt/truetaro/.env)
# NEVER commit .env
#
# VPS public address (Godot Android -> http://VPS_IP:API_PORT).
# Container always listens on internal 8000.
# Default 18437 — non-standard port; TrueTaro on the same VPS uses 17878.
# If busy: ss -tlnp | grep 18437 ; pick another free port and update android_base_url
VPS_IP=147.45.173.26
API_PORT=18437

PROXY_HOST=0.0.0.0
AI_QUEUE_TIMEOUT=5.0
AI_QUEUE_MAX_DEPTH=2
AI_TIMEOUT_SECONDS=20
SEMANTIC_THRESHOLD=0.82

# Required for real LLM answers. Paste the same key as TrueTaro / local proxy/.env
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_MODELS=GigaChat-2,GigaChat-2-Pro,GigaChat-2-Max,GigaChat-3-Ultra
GIGACHAT_VERIFY_SSL=true
GIGACHAT_CA_BUNDLE=ce/russian_trusted_root_ca_pem.crt
