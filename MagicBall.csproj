<Project Sdk="Godot.NET.Sdk/4.7.0">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>CrystalBall</RootNamespace>
    <AssemblyName>MagicBall</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <DefaultItemExcludes>$(DefaultItemExcludes);android/**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Android: только managed ORT; native .so подключается через export plugin (onnxruntime.aar). -->
  <PropertyGroup Condition="'$(GodotTargetPlatform)' == 'android'">
    <SuppressOnnxRuntimePlatformCompatibilityError>true</SuppressOnnxRuntimePlatformCompatibilityError>
  </PropertyGroup>

  <ItemGroup Condition="'$(GodotTargetPlatform)' != 'android'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.19.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.19.0" />
  </ItemGroup>
</Project>
